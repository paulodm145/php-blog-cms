.env
.env.install
/public/uploads/
/database/*.sql
/vendor/
/node_modules/
/storage/logs/
/.idea/
/.vscode/

/.superpowers/
/storage/

# Notas internas de planejamento (specs/plans) geradas durante o
# desenvolvimento assistido — nao sao documentacao do projeto e citam
# dados pessoais (e-mail, telefone de uma feature descartada) que nao
# tem por que ir pro repositorio publico.
/docs/superpowers/

# Artefatos locais de ferramentas de IA/agentes — estado de sessao, nao
# conteudo do projeto. Excecao: .claude/skills/publicar-conteudo/ e
# versionado de proposito, pra qualquer sessao do Claude Code que abrir
# este repo (em qualquer maquina) ja ter os fluxos do projeto disponiveis
# sem redescobri-los. Skills de terceiros instaladas via `npx skills`
# (ex: writing-plans, do pacote obra/superpowers) sao tooling pessoal
# generica, nao especifica deste projeto, entao ficam de fora.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/publicar-conteudo/
/.agents/
/skills-lock.json
.codex

# Credenciais locais da automação de LinkedIn — nunca versionar.
/scripts/linkedin/.credentials.json
