APP_NAME="paulorb.dev"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_INSTALLED=true

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=user
DB_PASSWORD=password
DB_CHARSET=utf8mb4

# Senha do root do MySQL dentro do container (uso administrativo/local only).
DB_ROOT_PASSWORD=root

# So pra teste local da API /api/mcp/* — nunca reaproveitar em producao.
MCP_API_KEY=chave-de-teste-local-docker-nao-usar-em-producao
